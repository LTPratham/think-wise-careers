# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Resend Email (Master Key — domain verified on Admissions)
RESEND_API_KEY_ADMISSIONS="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# App
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OpenWA (Free, Open-Source WhatsApp API Gateway: https://github.com/rmyndharis/OpenWA)
OPENWA_BASE_URL="http://localhost:2785"
OPENWA_SESSION_ID="default"
OPENWA_API_KEY="your-openwa-api-key"

